-- ===== Animation Logic (Loop Protection) =====
local function playAnimationPart(animId, startTime, endTime, loop, speed)
	if not currentHumanoid then return end
	if loop and loopingEmotes[animId] then return end
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://"..animId
	local track = currentHumanoid:LoadAnimation(anim)
	animTracks[animId] = track
	track:Play()
	track.TimePosition = startTime or 0
	track:AdjustSpeed(speed or 1)
	if loop then loopingEmotes[animId] = true end
	local len = (endTime or track.Length) - (startTime or 0)
	task.spawn(function()
		while loop and loopingEmotes[animId] and track.IsPlaying do
			task.wait(len)
			track.TimePosition = startTime or 0
		end
	end)
	track.Stopped:Connect(function()
		animTracks[animId] = nil
		loopingEmotes[animId] = nil
	end)
end

local function stopAnimation(id)
	if animTracks[id] then animTracks[id]:Stop() end
	animTracks[id] = nil
	loopingEmotes[id] = nil
end

local function stopAllAnimations()
	for id,t in pairs(animTracks) do
		if t then t:Stop() end
		loopingEmotes[id] = nil
	end
	animTracks = {}
end

