-- ===== تحميل / حفظ =====
local function loadEmotes()
	if type(isfile) == "function" and isfile(jsonFile) then
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(jsonFile))
		end)
		emotes = (ok and type(data) == "table") and data or {}
	end
end

local function saveEmotes()
	if type(writefile) == "function" then
		pcall(function()
			writefile(jsonFile, HttpService:JSONEncode(emotes))
		end)
	end
end

