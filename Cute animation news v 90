local function showDeleteConfirmation(emoteName)
	confirmLabel.Text = "Delete '"..emoteName.."'?"
	deleteConfirmFrame.Visible = true
	local yesConn, noConn
	local function cleanup()
		if yesConn then yesConn:Disconnect() end
		if noConn then noConn:Disconnect() end
		deleteConfirmFrame.Visible = false
	end
	yesConn = yesButton.MouseButton1Click:Connect(function()
		emotes[emoteName] = nil
		saveEmotes()
		updateEmoteList()
		cleanup()
	end)
	noConn = noButton.MouseButton1Click:Connect(cleanup)
end

-- ===== Update List =====
function updateEmoteList()
	for _,c in pairs(emoteList:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end

	local y = 0
	for name,data in pairs(emotes) do
		if currentSearchFilter == "" 
		or name:lower():find(currentSearchFilter,1,true)
		or tostring(data.id):find(currentSearchFilter,1,true) then

			local item = Instance.new("Frame", emoteList)
			item.Size = UDim2.new(1,0,0,40)
			item.Position = UDim2.new(0,0,0,y)
			item.BackgroundColor3 = Color3.fromRGB(45,45,45)

			local label = Instance.new("TextLabel", item)
			label.Size = UDim2.new(0.25,0,1,0)
			label.Text = name
			label.TextSize = 12
			label.BackgroundTransparency = 1
			label.TextColor3 = Color3.new(1,1,1)

			local function mkBtn(txt,x,fn)
				local b = Instance.new("TextButton", item)
				b.Size = UDim2.new(0,26,1,0)
				b.Position = UDim2.new(x,0,0,0)
				b.Text = txt
				b.TextSize = 12
				b.BackgroundColor3 = Color3.fromRGB(60,60,60)
				b.TextColor3 = Color3.new(1,1,1)
				b.MouseButton1Click:Connect(fn)
			end

			mkBtn("▶",0.25,function() playAnimationPart(data.id,data.startTime,data.endTime,false,tonumber(speedBox.Text) or 1) end)
			mkBtn("🔁",0.33,function() playAnimationPart(data.id,data.startTime,data.endTime,true,tonumber(speedBox.Text) or 1) end)
			mkBtn("■",0.41,function() stopAnimation(data.id) end)
			mkBtn("ALL",0.49,stopAllAnimations)
			mkBtn("DEL",0.57,function() showDeleteConfirmation(name) end)

			y += 42
		end
	end
	emoteList.CanvasSize = UDim2.new(0,0,0,y)
end

-- ===== Character Setup =====
local function setupCharacter(char)
	currentCharacter = char
	currentHumanoid = char:WaitForChild("Humanoid")
	currentAnimator = currentHumanoid:WaitForChild("Animator")

	if animPlayedConn then animPlayedConn:Disconnect() end
	animPlayedConn = currentAnimator.AnimationPlayed:Connect(function(track)
		local id = track.Animation.AnimationId:match("%d+")
		if id then
			currentAnimId = id
			animBtn.Text = id
		end
	end)
end

