	end

	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. tostring(id)

	local success, temp = pcall(function() return Animator:LoadAnimation(animation) end)
	if not success or not temp then
		status("فشل تحميل الرقصة")
		return
	end

	temp:Play(0)
	task.wait(0.25)
	local length = temp.Length
	temp:Stop(0)
	temp:Destroy()

	if not length or length <= 0 then
		status("لم يتم معرفة مدة الرقصة")
		return
	end

	local startTime = 0
	local count = 0

	while startTime < length do
		local endTime = math.min(startTime + slice, length)
		count += 1
		table.insert(savedAnimations, {
			Key = makeKey("SLICE"),
			Id = tostring(id),
			Start = startTime,
			End = endTime,
			Name = "Anim_" .. tostring(#savedAnimations + 1),
			Loop = true,
			IsFrozen = false
		})
		startTime = endTime
		if count >= 500 then break end
	end

	saveData(RDB_FILE, savedAnimations)
	refreshRDBList()
	IdInput.Text = ""
	SliceInput.Text = ""
	status("تم تقسيم الرقصة إلى " .. tostring(count) .. " أجزاء")
end)

