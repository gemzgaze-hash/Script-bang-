--==================================================
-- PLAY ANIMATION ENGINE
--==================================================
local function playAnimation(data, frozen, forceNewTrack)
	if not Animator or not data or not data.Id then return nil, nil end

	local key
	if forceNewTrack then
		key = makeKey("FROZEN_RUNTIME")
	else
		key = data.Key
		if not key then
			key = makeKey("TEMP")
			data.Key = key
		end
		if activeTracks[key] then
			stopTrack(key)
		end
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. tostring(data.Id)

	local success, track = pcall(function()
		return Animator:LoadAnimation(animation)
	end)

	if not success or not track then
		pcall(function() animation:Destroy() end)
		status("فشل تحميل الأنيميشن")
		return nil, nil
	end

	pcall(function()
		if Enum.AnimationPriority.Action4 then
			track.Priority = Enum.AnimationPriority.Action4
		else
			track.Priority = Enum.AnimationPriority.Action
		end
	end)

	stopExternalAnimations()

	local startTime = tonumber(data.Start) or 0
	local endTime = tonumber(data.End) or 0
	local resumeTime = tonumber(data.RuntimeTime)

	if frozen then
		resumeTime = tonumber(data.FrozenTime) or resumeTime
	end

	if resumeTime == nil then resumeTime = startTime end

	track.Looped = false
	pcall(function()
		track:Play(getFadeIn(), 10, 1)
		track:AdjustWeight(10, 0)
	end)
	task.wait()

	pcall(function() track.TimePosition = resumeTime end)

	if frozen then
		track:AdjustSpeed(0)
		data.IsFrozen = true
	else
		track:AdjustSpeed(getSpeed())
		data.IsFrozen = false
	end

	activeTracks[key] = track
	activeData[key] = data
	data.RuntimeTime = track.TimePosition

	trackConnections[key] = RunService.Heartbeat:Connect(function()
		if activeTracks[key] ~= track then
			disconnectTrack(key)
			return
		end

		pcall(function() track:AdjustWeight(10, 0) end)

		if data.IsFrozen then
			pcall(function()
				if tonumber(data.FrozenTime) then
					track.TimePosition = tonumber(data.FrozenTime)
				end
				track:AdjustSpeed(0)
			end)
			return
		end

		pcall(function() data.RuntimeTime = track.TimePosition end)

		if endTime > 0 and track.TimePosition >= endTime then
			pcall(function()
				track.TimePosition = startTime
				data.RuntimeTime = startTime
				track:AdjustSpeed(getSpeed())
			end)
		elseif not track.IsPlaying then
			pcall(function()
				track:Play(0, 10, 1)
				track:AdjustWeight(10, 0)
			end)
			task.wait()
			pcall(function()
				track.TimePosition = startTime
				data.RuntimeTime = startTime
				track:AdjustSpeed(getSpeed())
			end)
		end
	end)

	return track, key
end

--==================================================
-- RESTORE ANIMATIONS AFTER RESPAWN
--==================================================
restoreActiveAnimations = function()
	if not Animator then return end
	local restoreList = {}

	for key, data in pairs(activeData) do
		if data and data.Id then
			restoreList[#restoreList + 1] = { Key = key, Data = data }
		end
	end

	for _, item in ipairs(restoreList) do
		local key = item.Key
		local data = item.Data
		if activeData[key] ~= data then continue end

		local animation = Instance.new("Animation")
		animation.AnimationId = "rbxassetid://" .. tostring(data.Id)

		local success, track = pcall(function() return Animator:LoadAnimation(animation) end)
		if not success or not track then
			pcall(function() animation:Destroy() end)
			continue
		end

		pcall(function()
			if Enum.AnimationPriority.Action4 then
				track.Priority = Enum.AnimationPriority.Action4
			else
				track.Priority = Enum.AnimationPriority.Action
			end
		end)

		local startTime = tonumber(data.Start) or 0
		local endTime = tonumber(data.End) or 0
		local resumeTime

		if data.IsFrozen then
			resumeTime = tonumber(data.FrozenTime)
		else
			resumeTime = tonumber(data.RuntimeTime)
		end

		if resumeTime == nil then resumeTime = startTime end

		track.Looped = false
		pcall(function()
			track:Play(0, 10, 1)
			track:AdjustWeight(10, 0)
		end)
		task.wait()

		pcall(function() track.TimePosition = resumeTime end)

		if data.IsFrozen then
			pcall(function() track:AdjustSpeed(0) end)
		else
			pcall(function() track:AdjustSpeed(getSpeed()) end)
		end

		activeTracks[key] = track
		trackConnections[key] = RunService.Heartbeat:Connect(function()
			if activeTracks[key] ~= track then
				disconnectTrack(key)
				return
			end
			pcall(function() track:AdjustWeight(10, 0) end)
			if data.IsFrozen then
				pcall(function()
					if tonumber(data.FrozenTime) then
						track.TimePosition = tonumber(data.FrozenTime)
					end
					track:AdjustSpeed(0)
				end)
				return
			end
			pcall(function() data.RuntimeTime = track.TimePosition end)
			if endTime > 0 and track.TimePosition >= endTime then
				pcall(function()
					track.TimePosition = startTime
					data.RuntimeTime = startTime
					track:AdjustSpeed(getSpeed())
				end)
			elseif not track.IsPlaying then
				pcall(function()
					track:Play(0, 10, 1)
					track:AdjustWeight(10, 0)
					track.TimePosition = startTime
					data.RuntimeTime = startTime
					track:AdjustSpeed(getSpeed())
				end)
			end
		end)
	end
	status("تمت إعادة الرقصات بعد تغيير الشخصية")
end

