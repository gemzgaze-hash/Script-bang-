--==================================================
-- UNIQUE KEY GENERATOR
--==================================================
local function makeKey(prefix)
	return prefix .. "_" .. tostring(os.clock()) .. "_" .. tostring(math.random(100000, 999999))
end

--==================================================
-- JSON LOAD / SAVE
--==================================================
local function loadData(fileName)
	if isfile and isfile(fileName) then
		local success, result = pcall(function()
			return HttpService:JSONDecode(readfile(fileName))
		end)
		if success and type(result) == "table" then
			return result
		end
	end
	return {}
end

local function saveData(fileName, data)
	if writefile then
		pcall(function()
			writefile(fileName, HttpService:JSONEncode(data))
		end)
	end
end

savedAnimations = loadData(RDB_FILE)
frozenAnimations = loadData(FREEZE_FILE)

--==================================================
-- FIX OLD DATA
--==================================================
for index, data in ipairs(savedAnimations) do
	if not data.Key then data.Key = "RDB_OLD_" .. tostring(index) .. "_" .. makeKey("") end
	data.Id = tostring(data.Id or "")
	data.Start = tonumber(data.Start) or 0
	data.End = tonumber(data.End) or 0
end

for index, data in ipairs(frozenAnimations) do
	if not data.Key then data.Key = "FREEZE_OLD_" .. tostring(index) .. "_" .. makeKey("") end
	data.Id = tostring(data.Id or "")
	data.FrozenTime = tonumber(data.FrozenTime) or tonumber(data.TimePos) or tonumber(data.Start) or 0
end

saveData(RDB_FILE, savedAnimations)
saveData(FREEZE_FILE, frozenAnimations)

--==================================================
-- OVERRIDE EXTERNAL ANIMATIONS
--==================================================
local function stopExternalAnimations()
	if not Animator then return end
	local activeTrackSet = {}
	for _, track in pairs(activeTracks) do
		if track then activeTrackSet[track] = true end
	end
	for _, playingTrack in ipairs(Animator:GetPlayingAnimationTracks()) do
		if not activeTrackSet[playingTrack] then
			pcall(function() playingTrack:Stop(0) end)
		end
	end
end

RunService.Stepped:Connect(function()
	if next(activeTracks) ~= nil then
		stopExternalAnimations()
	end
end)

--==================================================
-- CHARACTER RESPAWN / CHARACTER CHANGE
--==================================================
local respawnGeneration = 0
local restoreActiveAnimations

LocalPlayer.CharacterAdded:Connect(function(char)
	respawnGeneration += 1
	local generation = respawnGeneration

	for key, track in pairs(activeTracks) do
		local data = activeData[key]
		if data and track and not data.IsFrozen then
			pcall(function() data.RuntimeTime = track.TimePosition end)
		end
	end

	for key, connection in pairs(trackConnections) do
		pcall(function() connection:Disconnect() end)
		trackConnections[key] = nil
	end

	for key, track in pairs(activeTracks) do
		pcall(function() track:Stop(0) track:Destroy() end)
		activeTracks[key] = nil
	end

	Character = char
	task.spawn(function()
		Humanoid = Character:WaitForChild("Humanoid", 10)
		if generation ~= respawnGeneration or not Humanoid then return end
		Animator = Humanoid:WaitForChild("Animator", 10)
		if generation ~= respawnGeneration or not Animator then return end

		task.wait(0.15)
		if generation ~= respawnGeneration then return end

		if restoreActiveAnimations then
			restoreActiveAnimations()
		end
	end)
end)

