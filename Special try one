--==================================================
-- SPAM FREEZE
--==================================================
local function stopSpam(key)
	spamLoops[key] = nil
	local data = activeData[key]
	if data then data.Spam = false end
end

local function startSpam(data)
	local key = data.Key
	if spamLoops[key] then
		stopSpam(key)
		return false
	end

	spamLoops[key] = true
	data.Spam = true

	task.spawn(function()
		while spamLoops[key] do
			local frozenTime = tonumber(data.FrozenTime) or 0
			data.IsFrozen = false

			local track = activeTracks[key]
			if not track then
				track = playAnimation(data, false, false)
			end

			if track then
				pcall(function()
					track:Play(0, 10, 1)
					track:AdjustWeight(10, 0)
					track.TimePosition = frozenTime
					track:AdjustSpeed(getSpeed())
				end)

				task.wait(1 / getSpamSpeed())
				if not spamLoops[key] then break end

				pcall(function()
					track.TimePosition = frozenTime
					track:AdjustSpeed(0)
				end)
				data.IsFrozen = true
				task.wait(1 / getSpamSpeed())
			end
		end

		local track = activeTracks[key]
		if track then
			pcall(function()
				track.TimePosition = tonumber(data.FrozenTime) or 0
				track:AdjustSpeed(0)
			end)
		end
		data.IsFrozen = true
		data.Spam = false
	end)
	return true
end

