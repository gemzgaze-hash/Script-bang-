-- السلايدر
local isSliding = false
local function updateSlider(input)
	local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
	sliderFill.Size = UDim2.new(pos, 0, 1, 0)
	crawlSpeed = math.floor(2 + (pos * 18))
	speedLabel.Text = "Crawl Speed: " .. crawlSpeed
	
	if isCrawling and humanoid then
		humanoid.WalkSpeed = crawlSpeed
	end
end

sliderBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isSliding = true
		updateSlider(input)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isSliding = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateSlider(input)
	end
end)

-- نظام المشي والأنيميشن
local animation = Instance.new("Animation")
local animTrack = nil
local renderConnection = nil

local function loadCrawlAnim()
	character = player.Character or player.CharacterAdded:Wait()
	humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")
	
	-- تنظيف الأنيميشن القديم إذا كان يعمل
	if animTrack then
		animTrack:Stop(0)
		animTrack:Destroy()
		animTrack = nil
	end

	-- استخراج المعرف فقط وتنظيف النص
	local cleanId = string.match(currentAnimId, "%d+") or currentAnimId
	animation.AnimationId = "rbxassetid://" .. cleanId

	animTrack = animator:LoadAnimation(animation)
	animTrack.Priority = Enum.AnimationPriority.Action4
	animTrack.Looped = true
end

player.CharacterAdded:Connect(loadCrawlAnim)
loadCrawlAnim()

local function startCrawling()
	if not animTrack then loadCrawlAnim() end
	
	humanoid.WalkSpeed = crawlSpeed

	if not animTrack.IsPlaying then
		animTrack:Play(0.1)
	end

	renderConnection = RunService.RenderStepped:Connect(function()
		if not isCrawling or not humanoid then return end
		
		local moveDir = humanoid.MoveDirection
		if moveDir.Magnitude > 0.05 then
			animTrack:AdjustSpeed(moveDir.Magnitude * (crawlSpeed / 8))
		else
			animTrack:AdjustSpeed(0)
		end
	end)
end

local function stopCrawling()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end

	if humanoid then
		humanoid.WalkSpeed = DEFAULT_WALK_SPEED
	end

	if animTrack and animTrack.IsPlaying then
		animTrack:Stop(0.2)
	end
end

toggleCrawlBtn.MouseButton1Click:Connect(function()
	isCrawling = not isCrawling
	if isCrawling then
		toggleCrawlBtn.Text = "CRAWL: ON"
		toggleCrawlBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
		startCrawling()
	else
		toggleCrawlBtn.Text = "CRAWL: OFF"
		toggleCrawlBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		stopCrawling()
	end
end)

-- زر حفظ وتطبيق الأنيميشن الجديد
saveAnimBtn.MouseButton1Click:Connect(function()
	local inputId = animTextBox.Text
	if inputId and inputId ~= "" then
		currentAnimId = inputId
		saveAnimId(currentAnimId) -- حفظ الملف بصيغة JSON
		
		-- إعادة تحميل الأنيميشن المطبق
		loadCrawlAnim()
		if isCrawling then
			stopCrawling()
			startCrawling()
		end
		
		saveAnimBtn.Text = "Saved Successfully!"
		saveAnimBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
		task.wait(1.5)
		saveAnimBtn.Text = "Save & Apply Anim"
		saveAnimBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
	end
end)
