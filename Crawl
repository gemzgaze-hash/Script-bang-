-- وظائف الحفظ والاسترجاع باستخدام JSON
local function loadSavedAnimId()
	if readfile and isfile and isfile(SAVE_FILE_NAME) then
		local success, result = pcall(function()
			local data = HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
			return data.AnimId
		end)
		if success and result then
			return tostring(result)
		end
	end
	return defaultAnimId
end

local function saveAnimId(id)
	if writefile then
		pcall(function()
			local data = { AnimId = tostring(id) }
			writefile(SAVE_FILE_NAME, HttpService:JSONEncode(data))
		end)
	end
end

