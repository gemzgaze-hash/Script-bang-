--==================================================
-- SPAM
--==================================================

local function stopSpam(key)

    spamLoops[key] = nil

    local data =
        activeData[key]

    if data then
        data.Spam = false
    end
end

local function startSpam(data)

    local key = data.Key

    if spamLoops[key] then

        stopSpam(key)

        return false
    end

    spamLoops[key] = true
    data.Spam = true

    task.spawn(function()

        while spamLoops[key] do

            local delayTime =
                1 / getSpamSpeed()

            data.IsFrozen = false

            local track =
                activeTracks[key]

            if not track then

                track =
                    playAnimation(
                        data,
                        false
                    )
            end

            if track then

                pcall(function()

                    track:Play(0)

                    track:AdjustSpeed(
                        getSpeed()
                    )

                end)
            end

            task.wait(delayTime)

            if not spamLoops[key] then
                break
            end

            track =
                activeTracks[key]

            if track then

                pcall(function()
                    track:Stop(0)
                end)
            end

            task.wait(delayTime)
        end
    end)

    return true
end

