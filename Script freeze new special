--==================================================
-- HELPERS
--==================================================

local function status(text)
    StatusLabel.Text = text
end

local function getSpeed()
    return math.max(
        tonumber(SpeedInput.Text) or 1,
        0
    )
end

local function getSpamSpeed()
    return math.max(
        tonumber(SpamSpeedInput.Text) or 5,
        0.1
    )
end

local function getFadeIn()
    return math.max(
        tonumber(FadeInInput.Text) or 0.1,
        0
    )
end

local function getFadeOut()
    return math.max(
        tonumber(FadeOutInput.Text) or 0.1,
        0
    )
end

local function disconnectTrack(key)

    if trackConnections[key] then

        trackConnections[key]:Disconnect()

        trackConnections[key] = nil
    end
end

local function stopTrack(key)

    disconnectTrack(key)

    if activeTracks[key] then

        pcall(function()
            activeTracks[key]:Stop(
                getFadeOut()
            )
        end)
    end

    activeTracks[key] = nil
    activeData[key] = nil
end

local function stopAll()

    for key in pairs(activeTracks) do
        stopTrack(key)
    end

    status("تم إيقاف الكل")
end

--==================================================
-- PLAY ANIMATION
--==================================================

local function playAnimation(data, frozen)

    if not Animator
        or not data
        or not data.Id then

        return nil
    end

    -- مهم جداً:
    -- نستخدم Key وليس ID
    -- حتى أجزاء نفس الرقصة تكون مستقلة
    local key = data.Key

    if not key then
        key = makeKey("TEMP")
        data.Key = key
    end

    if activeTracks[key] then
        stopTrack(key)
    end

    local animation =
        Instance.new("Animation")

    animation.AnimationId =
        "rbxassetid://"
        .. tostring(data.Id)

    local success, track =
        pcall(function()

            return Animator:LoadAnimation(
                animation
            )
        end)

    if not success or not track then

        status("فشل تحميل الأنيميشن")

        return nil
    end

    local startTime =
        tonumber(data.Start) or 0

    local endTime =
        tonumber(data.End) or 0

    track.Looped = false

    track:Play(getFadeIn())

    task.wait()

    if startTime > 0 then

        pcall(function()
            track.TimePosition =
                startTime
        end)
    end

    if frozen then

        track:AdjustSpeed(0)

        data.IsFrozen = true

    else

        track:AdjustSpeed(
            getSpeed()
        )

        data.IsFrozen = false
    end

    activeTracks[key] = track
    activeData[key] = data

    trackConnections[key] =
        RunService.Heartbeat:Connect(
            function()

                if activeTracks[key]
                    ~= track then

                    disconnectTrack(key)

                    return
                end

                if data.IsFrozen then

                    pcall(function()
                        track:AdjustSpeed(0)
                    end)

                    return
                end

                -- SLICE LOOP
                if endTime > 0
                    and track.TimePosition
                    >= endTime then

                    pcall(function()

                        track.TimePosition =
                            startTime

                    end)

                    track:AdjustSpeed(
                        getSpeed()
                    )

                elseif not track.IsPlaying then

                    track:Play(0)

                    task.wait()

                    pcall(function()

                        track.TimePosition =
                            startTime

                    end)

                    track:AdjustSpeed(
                        getSpeed()
                    )
                end
            end
        )

    return track
end

--==================================================
-- LIVE SPEED
--==================================================

local function applySpeed()

    local speed =
        getSpeed()

    for key, track in
        pairs(activeTracks) do

        local data =
            activeData[key]

        if track
            and data
            and not data.IsFrozen then

            pcall(function()

                track:AdjustSpeed(
                    speed
                )

            end)
        end
    end

    status(
        "السرعة: "
        .. tostring(speed)
        .. "x"
    )
end

SpeedInput.FocusLost:Connect(
    applySpeed
)

SpeedInput:GetPropertyChangedSignal(
