        if found then

            status(
                "تم تجميد الكل - Enter للفك"
            )

        else

            status(
                "لا يوجد أنيميشن"
            )
        end
    end
)

--==================================================
-- UNFREEZE ALL
--==================================================

local function unfreezeAll()

    local found = false

    for key, data in
        pairs(activeData) do

        if data
            and data.IsFrozen then

            data.IsFrozen = false

            local track =
                activeTracks[key]

            if track then

                pcall(function()

                    track:AdjustSpeed(
                        getSpeed()
                    )

                end)
            end

            found = true
        end
    end

    if found then

        status(
            "تم إلغاء التجميد"
        )
    end
end

