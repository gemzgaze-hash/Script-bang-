--==================================================
-- ADD / SLICE
--==================================================

AddBtn.MouseButton1Click:Connect(
    function()

        local id =
            IdInput.Text:match("%d+")

        if not id then

            status(
                "أدخل ID صحيح"
            )

            return
        end

        local slice =
            tonumber(
                SliceInput.Text
            )

        --================================================
        -- NORMAL ANIMATION
        --================================================

        if not slice
            or slice <= 0 then

            table.insert(
                savedAnimations,
                {
                    Key =
                        makeKey("RDB"),

                    Id =
                        tostring(id),

                    Start = 0,
                    End = 0,

                    Name =
                        "Anim_"
                        .. tostring(
                            #savedAnimations + 1
                        ),

                    Loop = true,
                    IsFrozen = false
                }
            )

            saveData(
                RDB_FILE,
                savedAnimations
            )

            refreshRDBList()

            IdInput.Text = ""
            SliceInput.Text = ""

            status(
                "تمت الإضافة"
            )

            return
        end

        --================================================
        -- LOAD ANIMATION LENGTH
        --================================================

        local animation =
            Instance.new("Animation")

        animation.AnimationId =
            "rbxassetid://"
            .. tostring(id)

        local success, temp =
            pcall(function()

                return Animator:LoadAnimation(
                    animation
                )
            end)

        if not success or not temp then

            status(
                "فشل تحميل الرقصة"
            )

            return
        end

        temp:Play(0)

        task.wait(0.25)

        local length =
            temp.Length

        temp:Stop(0)
        temp:Destroy()

        if not length
            or length <= 0 then

            status(
                "لم يتم معرفة مدة الرقصة"
            )

            return
        end

        --================================================
        -- SPLIT INTO MULTIPLE PARTS
        --================================================

        local startTime = 0
        local count = 0

        while startTime < length do

            local endTime =
                math.min(
                    startTime + slice,
                    length
                )

            count += 1

            -- كل Slice له Key مختلف
            table.insert(
                savedAnimations,
                {
                    Key =
                        makeKey(
                            "SLICE"
                        ),

                    Id =
                        tostring(id),

                    Start =
                        startTime,

                    End =
                        endTime,

                    Name =
                        "Anim_"
                        .. tostring(
                            #savedAnimations + 1
                        ),

                    Loop = true,
                    IsFrozen = false
                }
            )

            startTime = endTime

            if count >= 500 then
                break
            end
        end

        saveData(
            RDB_FILE,
            savedAnimations
        )

        refreshRDBList()

        IdInput.Text = ""
        SliceInput.Text = ""

        status(
            "تم تقسيم الرقصة إلى "
            .. tostring(count)
            .. " أجزاء"
        )
    end
)

