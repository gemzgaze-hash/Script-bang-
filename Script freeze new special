    if not data.Key then
        data.Key = "RDB_OLD_" .. tostring(index) .. "_" .. makeKey("")
    end

    data.Id = tostring(data.Id or "")
    data.Start = tonumber(data.Start) or 0
    data.End = tonumber(data.End) or 0
end

for index, data in ipairs(frozenAnimations) do
    if not data.Key then
        data.Key = "FREEZE_OLD_" .. tostring(index) .. "_" .. makeKey("")
    end

    data.Id = tostring(data.Id or "")
    data.FrozenTime =
        tonumber(data.FrozenTime)
        or tonumber(data.TimePos)
        or tonumber(data.Start)
        or 0
end

