-- ============================================
-- ANIMATIONS
-- ============================================
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function setOpen(state)
	if state then
		MainFrame.Visible = true
		local t = TweenService:Create(MainFrame, tweenInfo, {Position = openPos})
		t:Play()
	else
		local t = TweenService:Create(MainFrame, tweenInfo, {Position = closedPos})
		t:Play()
		t.Completed:Connect(function()
			MainFrame.Visible = false
		end)
	end
end

-- ============================================
-- EXECUTE BUTTON FUNCTIONALITY
-- ============================================
ExecuteButton.MouseButton1Click:Connect(function()
	ExecuteButton.Text = "⏳"
	ExecuteButton.Active = false
	
	local rawUrl = "https://raw.githubusercontent.com/gemzgaze-hash/Script-bang-/main/Bang%20script"
	local ok, result = pcall(function()
		local body = game:HttpGet(rawUrl)
		if not body or #body == 0 then
			error("Script not found")
		end
		local f = loadstring(body)
		if type(f) ~= "function" then
			error("Invalid script")
		end
		f()
	end)

	if ok then
		ExecuteButton.Text = "✓"
		ExecuteButton.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
		
		task.delay(1.2, function()
			if ExecuteButton and ExecuteButton.Parent then
				ExecuteButton.Text = "▶ RUN"
				ExecuteButton.BackgroundColor3 = NEON_PURPLE
			end
		end)
	else
		warn("Error:", result)
		ExecuteButton.Text = "✗"
		ExecuteButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
		
		task.delay(1.2, function()
			if ExecuteButton and ExecuteButton.Parent then
				ExecuteButton.Text = "▶ RUN"
				ExecuteButton.BackgroundColor3 = NEON_PURPLE
			end
		end)
	end
	
	ExecuteButton.Active = true
end)

