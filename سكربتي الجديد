-- ============================================
-- KEYBOARD
-- ============================================
UIS.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape then
		setOpen(false)
	end
end)
