--// RESPONSIVE SCALE
local Camera = workspace.CurrentCamera

local function UpdateScale()
	if not Camera then
		return
	end

	local Width = Camera.ViewportSize.X

	if Width <= 500 then
		UIScale.Scale = 0.82
	elseif Width <= 800 then
		UIScale.Scale = 0.9
	else
		UIScale.Scale = 1
	end
end

UpdateScale()

if Camera then
	Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)
end
