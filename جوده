--==================================================
-- ORIGINAL VALUES
--==================================================

local Original = {}

local function remember(instance, property, value)

    if not Original[instance] then
        Original[instance] = {}
    end

    if Original[instance][property] == nil then
        Original[instance][property] = value
    end
end

local function restore(instance)

    local data = Original[instance]

    if not data then
        return
    end

    for property, value in pairs(data) do

        pcall(function()
            instance[property] = value
        end)

    end
end

--==================================================
-- HELPERS
--==================================================

local function isMyCharacter(instance)

    local character = LocalPlayer.Character

    return character
        and instance:IsDescendantOf(character)
end

local function isOtherPlayerCharacter(instance)

    local model = instance:FindFirstAncestorOfClass("Model")

    if not model then
        return false
    end

    local player = Players:GetPlayerFromCharacter(model)

    return player ~= nil and player ~= LocalPlayer
end

local function isMapObject(instance)

    if isMyCharacter(instance) then
        return false
    end

    if isOtherPlayerCharacter(instance) then
        return false
    end

    return true
end

--==================================================
-- LOW GRAPHICS (MAP ONLY - PRESERVES SKINS & ANIMS)
--==================================================

local function applyLowGraphics(enabled)

    for _, object in ipairs(workspace:GetDescendants()) do

        -- الحفاظ الكامل على شخصيتك وباقي اللاعبين
        if not isMyCharacter(object) then

            if isOtherPlayerCharacter(object) then

                if object:IsA("BasePart") then

                    remember(
                        object,
                        "CastShadow",
                        object.CastShadow
                    )

                    if enabled then
                        object.CastShadow = false
                    else
                        restore(object)
                    end

                end

            -- الخريطة فقط يتم تقليل جودتها
            elseif isMapObject(object) then

                if object:IsA("BasePart") then

                    remember(
                        object,
                        "CastShadow",
                        object.CastShadow
                    )

                    remember(
                        object,
                        "Material",
                        object.Material
                    )

                    if enabled then

                        object.CastShadow = false
                        object.Material = Enum.Material.SmoothPlastic

                    else

                        restore(object)

                    end
                end
            end
        end
    end
end

--==================================================
-- PLAYERS
--==================================================

local function applyPlayers(enabled)

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer and player.Character then

            for _, object in ipairs(player.Character:GetDescendants()) do

                if object:IsA("BasePart") then

                    remember(
                        object,
                        "LocalTransparencyModifier",
                        object.LocalTransparencyModifier
                    )

                    if enabled then
                        object.LocalTransparencyModifier = 1
                    else
                        restore(object)
                    end

                elseif object:IsA("Decal")
                or object:IsA("Texture") then

                    remember(
                        object,
                        "Transparency",
                        object.Transparency
                    )

                    if enabled then
                        object.Transparency = 1
                    else
                        restore(object)
                    end
                end
            end
        end
    end
end

--==================================================
-- MAP
--==================================================

local function applyMap(enabled)

    for _, object in ipairs(workspace:GetDescendants()) do

        if isMapObject(object) then

            if object:IsA("BasePart") then

                remember(
                    object,
                    "LocalTransparencyModifier",
                    object.LocalTransparencyModifier
                )

                if enabled then
                    object.LocalTransparencyModifier = 1
                else
                    restore(object)
                end

            elseif object:IsA("Decal")
            or object:IsA("Texture") then

                remember(
                    object,
                    "Transparency",
                    object.Transparency
                )

                if enabled then
                    object.Transparency = 1
                else
                    restore(object)
                end
            end
        end
    end
end

--==================================================
-- TEXTURES (EXCLUDES PLAYER SKINS & CHARACTERS)
--==================================================

local function applyTextures(enabled)

    for _, object in ipairs(workspace:GetDescendants()) do

        -- يتجاهل شخصيتك وشخصيات اللاعبين الآخرين لعدم تخريب السكنات
        if not isMyCharacter(object) and not isOtherPlayerCharacter(object) then

            if object:IsA("Decal")
            or object:IsA("Texture") then

                remember(
                    object,
                    "Transparency",
                    object.Transparency
                )

                if enabled then
                    object.Transparency = 1
                else
                    restore(object)
                end
            end
        end
    end
end

--==================================================
-- PARTICLES / TRAILS / BEAMS
--==================================================

local function applyParticles(enabled)

    for _, object in ipairs(workspace:GetDescendants()) do

        if not isMyCharacter(object) then

            if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam") then

                remember(
                    object,
                    "Enabled",
                    object.Enabled
                )

                if enabled then
                    object.Enabled = false
                else
                    restore(object)
                end
            end
        end
    end
end

--==================================================
-- FIRE / SMOKE / SPARKLES (NEW FEATURE)
--==================================================

local function applyDisableEffects(enabled)

    for _, object in ipairs(workspace:GetDescendants()) do

        if not isMyCharacter(object) then

            if object:IsA("Fire")
            or object:IsA("Smoke")
            or object:IsA("Sparkles") then

                remember(
                    object,
                    "Enabled",
                    object.Enabled
                )

                if enabled then
                    object.Enabled = false
                else
                    restore(object)
                end
            end
        end
    end
end

--==================================================
-- HIDE TYPING / BUBBLES (NEW FEATURE)
--==================================================

local function applyHideTyping(enabled)

    for _, object in ipairs(workspace:GetDescendants()) do

        if object.Name == "TypingIndicator" or object.Name == "ChatBubble" or object:IsA("BillboardGui") and object.Name:lower():find("typing") then

            remember(
                object,
                "Enabled",
                object.Enabled
            )

            if enabled then
                object.Enabled = false
            else
                restore(object)
            end
        end
    end

    -- إخفاء فقاعات المحادثة الرسمية
    pcall(function()
        game:GetService("Chat"):SetBubbleChatEnabled(not enabled)
    end)
end

--==================================================
-- SOUNDS
--==================================================

local function applySounds(enabled)

    for _, object in ipairs(workspace:GetDescendants()) do

        if object:IsA("Sound") then

            remember(
                object,
                "Volume",
                object.Volume
            )

            if enabled then
                object.Volume = 0
            else
                restore(object)
            end
        end
    end
end

