local function setupPlayer(player)

    if player == LocalPlayer then
        return
    end

    player.CharacterAdded:Connect(function()

        task.wait(0.5)

        if Settings.Players then
            applyPlayers(true)
        end

        if Settings.LowGraphics then
            applyLowGraphics(true)
        end
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

--==================================================
-- NEW OBJECT SUPPORT
--==================================================

workspace.DescendantAdded:Connect(function(object)

    task.defer(function()

        if not object.Parent then
            return
        end

        -- Never modify your own character
        if isMyCharacter(object) then
            return
        end

        if Settings.LowGraphics then

            if object:IsA("BasePart") then

                if isOtherPlayerCharacter(object) then

                    pcall(function()
                        object.CastShadow = false
                    end)

                elseif isMapObject(object) then

                    pcall(function()
                        object.CastShadow = false
                        object.Material = Enum.Material.SmoothPlastic
                    end)
                end
            end
        end

        if Settings.Players
        and isOtherPlayerCharacter(object) then

            if object:IsA("BasePart") then
                object.LocalTransparencyModifier = 1
            elseif object:IsA("Decal")
            or object:IsA("Texture") then
                object.Transparency = 1
            end
        end

        if Settings.Map
        and isMapObject(object) then

            if object:IsA("BasePart") then
                object.LocalTransparencyModifier = 1
            elseif object:IsA("Decal")
            or object:IsA("Texture") then
                object.Transparency = 1
            end
        end

        if Settings.Textures and not isOtherPlayerCharacter(object) then

            if object:IsA("Decal")
            or object:IsA("Texture") then

                object.Transparency = 1
            end
        end

        if Settings.Particles
        and not isMyCharacter(object) then

            if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam") then

                object.Enabled = false
            end
        end

        if Settings.DisableEffects
        and not isMyCharacter(object) then

            if object:IsA("Fire")
            or object:IsA("Smoke")
            or object:IsA("Sparkles") then

                object.Enabled = false
            end
        end

        if Settings.HideTyping then
            if object.Name == "TypingIndicator" or object.Name == "ChatBubble" or object:IsA("BillboardGui") and object.Name:lower():find("typing") then
                object.Enabled = false
            end
        end

        if Settings.Sounds
        and object:IsA("Sound") then

            object.Volume = 0
        end

    end)
end)

