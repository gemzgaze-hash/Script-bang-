--==================================================
-- SETTINGS / JSON
--==================================================

local FILE_NAME = "LocalPerformanceSettings.json"

local Settings = {
    LowGraphics = false,
    Players = false,
    Map = false,
    Textures = false,
    Particles = false,
    Sounds = false,
    HideTyping = false, -- توجل جديد لإلغاء مؤشر الكتابة/النمش
    DisableEffects = false, -- توجل جديد لإلغاء التأثيرات (نار، دخان، شرار) دون حذف البارتات
}

local function loadSettings()
    if not (readfile and isfile) then
        return
    end

    local ok, exists = pcall(function()
        return isfile(FILE_NAME)
    end)

    if not ok or not exists then
        return
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(FILE_NAME))
    end)

    if success and type(data) == "table" then
        for key, default in pairs(Settings) do
            if type(data[key]) == "boolean" then
                Settings[key] = data[key]
            else
                Settings[key] = default
            end
        end
    end
end

local function saveSettings()
    if not writefile then
        return
    end

    pcall(function()
        writefile(
            FILE_NAME,
            HttpService:JSONEncode(Settings)
        )
    end)
end

loadSettings()

